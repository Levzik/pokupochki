<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <!-- Checkbox Image (Click toggles done) -->
    <ImageView
        android:id="@+id/item_checkbox"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_checkbox_unchecked"
        android:contentDescription="Статус" />

    <!-- Title & Price Container (Click toggles done) -->
    <LinearLayout
        android:id="@+id/item_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Хлеб"
            android:textColor="#1C1917"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="90 ₽"
            android:textColor="#1C1917"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Delete button (Click removes item from list) -->
    <ImageView
        android:id="@+id/item_btn_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="4dp"
        android:src="@drawable/ic_delete_gray"
        android:contentDescription="Удалить товар" />

</LinearLayout>
